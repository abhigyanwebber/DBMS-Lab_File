-- ============================================================
-- EXPERIMENT 7: SALES NORMALIZATION FROM UNF TO 3NF AND BCNF
-- Uses a separate practice database as specified in the practical.
-- Run this script from top to bottom in a fresh database.
-- ============================================================

CREATE DATABASE IF NOT EXISTS db_sales_normalization;
USE db_sales_normalization;

-- 1. UNF DATA AND FUNCTIONAL DEPENDENCIES
-- UNF is conceptual: Items contains a repeating product group.
-- Functional dependencies:
-- Order_ID -> Order_Date, Customer_ID, Salesperson_ID
-- Customer_ID -> Customer_Name, Customer_City
-- Salesperson_ID -> Salesperson_Name
-- Product_ID -> Product_Name, Unit_Price
-- (Order_ID, Product_ID) -> Quantity

-- 2. CONVERT UNF TO 1NF
CREATE TABLE sales_1nf (
    order_id INT,
    order_date DATE,
    customer_id INT,
    customer_name VARCHAR(60),
    customer_city VARCHAR(40),
    salesperson_id INT,
    salesperson_name VARCHAR(60),
    product_id INT,
    product_name VARCHAR(60),
    unit_price DECIMAL(10,2),
    quantity INT,
    PRIMARY KEY (order_id, product_id)
);

