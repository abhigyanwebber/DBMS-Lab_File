-- TEST 1NF
SELECT order_id, product_id, product_name, quantity
FROM sales_1nf
ORDER BY order_id, product_id;

-- 3. CONVERT 1NF TO 2NF
CREATE TABLE orders_2nf (
    order_id INT PRIMARY KEY,
    order_date DATE,
    customer_id INT,
    customer_name VARCHAR(60),
    customer_city VARCHAR(40),
    salesperson_id INT,
    salesperson_name VARCHAR(60)
);

CREATE TABLE products_2nf (
    product_id INT PRIMARY KEY,
    product_name VARCHAR(60),
    unit_price DECIMAL(10,2)
);

CREATE TABLE order_items_2nf (
    order_id INT,
    product_id INT,
    quantity INT,
    PRIMARY KEY (order_id, product_id),
    FOREIGN KEY (order_id) REFERENCES orders_2nf(order_id),
    FOREIGN KEY (product_id) REFERENCES products_2nf(product_id)
);

INSERT INTO orders_2nf
SELECT DISTINCT order_id, order_date, customer_id, customer_name,
       customer_city, salesperson_id, salesperson_name
FROM sales_1nf;

INSERT INTO products_2nf
SELECT DISTINCT product_id, product_name, unit_price
FROM sales_1nf;

INSERT INTO order_items_2nf
SELECT order_id, product_id, quantity
FROM sales_1nf;

-- TEST 2NF
SELECT o.order_id, o.customer_id, oi.product_id,
       p.product_name, oi.quantity
FROM orders_2nf o
JOIN order_items_2nf oi ON oi.order_id = o.order_id
JOIN products_2nf p ON p.product_id = oi.product_id
ORDER BY o.order_id;

-- 4. CONVERT 2NF TO 3NF
CREATE TABLE customers (
    customer_id INT PRIMARY KEY,
    customer_name VARCHAR(60) NOT NULL,
    customer_city VARCHAR(40) NOT NULL
);

CREATE TABLE salespersons (
    salesperson_id INT PRIMARY KEY,
    salesperson_name VARCHAR(60) NOT NULL
);

CREATE TABLE products (
    product_id INT PRIMARY KEY,
    product_name VARCHAR(60) NOT NULL,
    unit_price DECIMAL(10,2) NOT NULL
);

CREATE TABLE orders (
    order_id INT PRIMARY KEY,
    order_date DATE NOT NULL,
    customer_id INT NOT NULL,
    salesperson_id INT NOT NULL,
    FOREIGN KEY (customer_id) REFERENCES customers(customer_id),
    FOREIGN KEY (salesperson_id) REFERENCES salespersons(salesperson_id)
);

CREATE TABLE order_items (
    order_id INT,
    product_id INT,
    quantity INT NOT NULL,
    PRIMARY KEY (order_id, product_id),
    FOREIGN KEY (order_id) REFERENCES orders(order_id),
    FOREIGN KEY (product_id) REFERENCES products(product_id)
);

-- POPULATE THE 3NF TABLES
INSERT INTO customers
SELECT DISTINCT customer_id, customer_name, customer_city
FROM sales_1nf;

INSERT INTO salespersons
SELECT DISTINCT salesperson_id, salesperson_name
FROM sales_1nf;

INSERT INTO products
SELECT DISTINCT product_id, product_name, unit_price
FROM sales_1nf;

INSERT INTO orders
SELECT DISTINCT order_id, order_date, customer_id, salesperson_id
FROM sales_1nf;

INSERT INTO order_items
SELECT order_id, product_id, quantity
FROM sales_1nf;

-- 5. VERIFY 3NF DATA USING JOIN
SELECT o.order_id, c.customer_name, p.product_name,
       oi.quantity, p.unit_price
FROM orders o
JOIN customers c ON c.customer_id = o.customer_id
JOIN order_items oi ON oi.order_id = o.order_id
JOIN products p ON p.product_id = oi.product_id
ORDER BY o.order_id, p.product_id;

-- 6. BCNF ANALYSIS (under the stated functional dependencies)
-- CUSTOMERS: customer_id -> customer_name, customer_city
-- SALESPERSONS: salesperson_id -> salesperson_name
-- PRODUCTS: product_id -> product_name, unit_price
-- ORDERS: order_id -> order_date, customer_id, salesperson_id
-- ORDER_ITEMS: (order_id, product_id) -> quantity
-- Every determinant is a candidate key/superkey in its relation.

-- 7. VERIFY LOSSLESS JOIN
SELECT
    (SELECT COUNT(*) FROM sales_1nf) AS original_rows,
    (SELECT COUNT(*)
     FROM orders o
     JOIN order_items oi ON oi.order_id = o.order_id
     JOIN customers c ON c.customer_id = o.customer_id
     JOIN products p ON p.product_id = oi.product_id
     JOIN salespersons s ON s.salesperson_id = o.salesperson_id
    ) AS joined_rows;

-- 8. VERIFY DEPENDENCY PRESERVATION: ORDER-LEVEL DEPENDENCIES
SELECT order_id
FROM sales_1nf
GROUP BY order_id
HAVING COUNT(DISTINCT order_date) > 1
    OR COUNT(DISTINCT customer_id) > 1
    OR COUNT(DISTINCT salesperson_id) > 1;

-- PRODUCT-LEVEL DEPENDENCY
SELECT product_id
FROM sales_1nf
GROUP BY product_id
HAVING COUNT(DISTINCT product_name) > 1
    OR COUNT(DISTINCT unit_price) > 1;

-- 9. CHECK PRIMARY KEYS
SELECT table_name, column_name, constraint_name
FROM information_schema.key_column_usage
WHERE table_schema = DATABASE()
  AND constraint_name = 'PRIMARY'
ORDER BY table_name, ordinal_position;

